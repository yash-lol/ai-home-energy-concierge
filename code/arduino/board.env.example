# Board-side runtime config for uno_q_publisher.py — COMMIT this file (placeholders only).
# Copy to board.env and edit. board.env is gitignored: it holds LAN specifics,
# not secrets, but it is machine-specific and should not be committed.
#
# Usage on the UNO Q:
#   set -a; . ./board.env; set +a
#   ~/energy-venv/bin/python3 uno_q_publisher.py

# ── Hub / broker ────────────────────────────────────────────────────────────
# The PC running hub/server.py and mosquitto. Changes with the network.
MQTT_HOST=192.168.86.34
MQTT_PORT=1883
ROOM=living

# If the board is USB-only (no Wi-Fi), run this on the PC instead and use
# MQTT_HOST=127.0.0.1 — it tunnels the broker over the USB cable:
#   adb reverse tcp:1883 tcp:1883

# ── Kasa smart devices — the real physical actuator ─────────────────────────
# Two ways to bind, tried in this order:
#   1. *_HOST   an IP. Fast and deterministic, but DHCP will change it.
#   2. *_ALIAS  the device name as shown in the Kasa app. Survives IP changes,
#               BUT relies on UDP broadcast discovery, which is blocked on some
#               mesh Wi-Fi networks (confirmed blocked on the ArtiFi mesh —
#               discovery from the board found nothing while direct TCP to
#               port 9999 worked fine). Prefer _HOST when discovery is blocked.
#
# Find current IPs from a machine where discovery DOES work:
#   .venv/Scripts/kasa.exe discover
# QUOTE any value containing spaces. `set -a; . ./board.env` runs this through
# bash, so an unquoted `KASA_AC_ALIAS=Space heater` assigns "Space" and then
# tries to execute `heater`. It fails silently enough to reach demo day.
KASA_LIGHTS_HOST=192.168.86.49
KASA_LIGHTS_ALIAS="Bedroom light 2"

KASA_AC_HOST=192.168.86.20
KASA_AC_ALIAS="Space heater"

# Add more loads by listing them here and setting matching _HOST/_ALIAS vars.
#
# !! USE A LOAD NAME THE RULES ACTUALLY RECOGNISE. hub/rules.py matches on the
# !! load NAME, so a load called "fan" is ignored by every rule — it would show
# !! up in total watts and never produce a single recommendation.
# !!
# !! Recognised names (hub/rules.py LOAD_KEY_MAP / HVAC_LOADS / DEFERRABLE_LOADS):
# !!   lights      R1 unoccupied_lights_on, R3 daylight_waste
# !!   ac, heater  R2 away_with_hvac_on, R4 window-open heuristic, R7 comfort gate
# !!   standby     R5 phantom_standby
# !!   dryer, dishwasher   R6 peak_hour_heavy_load (needs >= 1000 W)
# !!   tv, pc      counted in total power only
#
# So to bring a table fan as a stand-in for HVAC, bind it as "ac" (or "heater"),
# NOT as "fan":
#   KASA_LOADS=lights,ac
#   KASA_AC_ALIAS="Table fan"
#
# Adding a genuinely new load type means adding it to LOAD_KEY_MAP in
# hub/rules.py and to LOADS in hub/energy_model.py as well.
KASA_LOADS=lights,ac

# How often to re-read measured power from metered devices (seconds).
# 30, not 5: a KL120 bulb visibly dips each time it is polled, so a 5 s cadence
# makes it flicker ~12x a minute on camera. Our own switches publish immediately,
# so this only affects how fast we notice a change made outside the system.
KASA_POLL_S=30
# Discovery timeout when falling back to alias lookup.
KASA_DISCOVER_S=8
# Pause after a switch before reading state back, so the device has applied it.
KASA_SETTLE_S=0.4

# ── Who owns which sensor signal ────────────────────────────────────────────
# The hub merges room state, so the LAST publisher of a key wins. The MCU
# republishes at 1 Hz and will therefore overwrite anything POSTed to
# /api/sensor within a second. Be explicit about the split:
#
#   MCU_SIGNALS=temp_c   Modulino Knob owns temperature. Turn the physical dial
#                        past 27 C to make the R7 comfort guardrail refuse an
#                        A/C shutoff — the most persuasive moment in the demo.
#   MCU_SIGNALS=         MCU publishes no sensor values; the phone/simulator
#                        owns everything. Use this to demo hands-free.
#
# Whatever is NOT listed here is left for the simulator to supply.
MCU_SIGNALS=temp_c

# ── MCU link ────────────────────────────────────────────────────────────────
# On the UNO Q the STM32's Serial does NOT appear as /dev/ttyACM*. It reaches
# Linux through the arduino-router service on this socket. Defaults are correct
# for a stock board; override only if the router is reconfigured.
MCU_TCP_HOST=127.0.0.1
MCU_TCP_PORT=7500
